# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,cfg}]
indent_style = space
indent_size = 2

[*.{rst,md}]
indent_style = space
indent_size = 2

[*.{po,pot}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
indent_size = 4
