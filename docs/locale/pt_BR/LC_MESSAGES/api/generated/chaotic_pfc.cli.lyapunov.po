#: chaotic_pfc.cli.lyapunov:1 of
msgid "Lyapunov exponent computation (text output + optional CSV)."
msgstr "Lyapunov exponent computation (text output + optional CSV)."

#: chaotic_pfc.cli.lyapunov:4 of
msgid "**Part A** — pure 2-D Henon, single perturbed IC, both fixed points."
msgstr "**Part A** — pure 2-D Henon, single perturbed IC, both fixed points."

#: chaotic_pfc.cli.lyapunov:5 of
msgid "**Part B** — 4-D Pole-filtered Henon, single perturbed IC."
msgstr "**Part B** — 4-D Pole-filtered Henon, single perturbed IC."

#: chaotic_pfc.cli.lyapunov:6 of
msgid ""
"**Part C** — 2-D Henon ensemble, ``n_ci`` ICs drawn uniformly in "
"``±perturbation`` around the fixed point."
msgstr ""
"**Part C** — 2-D Henon ensemble, ``n_ci`` ICs drawn uniformly in "
"``±perturbation`` around the fixed point."

#: chaotic_pfc.cli.lyapunov:8 of
msgid "**Part D** — 4-D Pole-filtered ensemble, same protocol, 4-D system."
msgstr "**Part D** — 4-D Pole-filtered ensemble, same protocol, 4-D system."

#: chaotic_pfc.cli.lyapunov:10 of
msgid ""
"Parts A/B are quick sanity checks; parts C/D implement the full "
"experimental protocol. With ``--save`` the per-IC tables are written to "
"``data/lyapunov/henon2d_ensemble.csv`` and "
"``data/lyapunov/henon4d_ensemble.csv``."
msgstr ""
"Parts A/B are quick sanity checks; parts C/D implement the full "
"experimental protocol. With ``--save`` the per-IC tables are written to "
"``data/lyapunov/henon2d_ensemble.csv`` and "
"``data/lyapunov/henon4d_ensemble.csv``."

